# Copy to .env (chmod 600) and fill in. Generate a token with:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
MISSION_CONTROL_V2_API_TOKEN=change-me
BIND_HOST=127.0.0.1
BIND_PORT=8742
# Optional: Hermes data root (default ~/.hermes). $HERMES_HOME is intentionally ignored.
# MISSION_CONTROL_V2_HERMES_ROOT=/home/you/.hermes
